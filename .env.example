# Modelo do .env da central do ZenMonitor.
# Copie para ".env" NA PASTA DO zen-central.exe (no PC1: C:\ZenMonitorNovo\target\release\.env)
# e cole as chaves depois do "=". O .env está no .gitignore: nunca vai para o GitHub nem para
# os agentes. A central relê este arquivo a cada análise, então não precisa reiniciar.

# Liga a análise de falhas por IA (1 = ligada, 0 = desligada).
ZEN_IA_LIGADA=0

# Chaves (deixe vazio o que não usar; a ordem de tentativa é groq -> gemini -> grok -> openrouter).
# Groq (console.groq.com) — não confundir com o Grok da xAI.
ZEN_IA_GROQ_KEY=
# Google Gemini (aistudio.google.com/apikey).
ZEN_IA_GEMINI_KEY=
# Grok da xAI (console.x.ai).
ZEN_IA_GROK_KEY=
# OpenRouter (openrouter.ai/keys).
ZEN_IA_OPENROUTER_KEY=

# Outras opções que a central já lia do .env:
# ZEN_AUTO_PAIRING=1
# ZEN_NTFY_URL=
# ZEN_BIND=0.0.0.0:8787
